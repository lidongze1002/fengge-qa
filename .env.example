# B 站登录态：主用浏览器 cookie，浏览器不可用时才填 BILI_COOKIE
BILI_BROWSER=edge
# BILI_COOKIE=SESSDATA=xxx; bili_jct=yyy

# LLM / embedding（沿用系统里已存在的变量名 OPEN_API_KEY）
OPEN_API_KEY=
# OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ASR
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8_float16

# 抓取与验收
UP_MID=433004026
TRIAL_SIZE=300
DEDUPE_THRESHOLD=0.92
VERIFY_THRESHOLD=0.62
